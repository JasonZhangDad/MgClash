{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MgClash",
  "version": "0.1.0",
  "identifier": "com.magies.mgclash",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MgClash",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 600
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/512x512.png", "icons/icon.ico"]
  }
}
