{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MgClash",
  "version": "0.1.0",
  "identifier": "com.magies.mgclash",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MgClash",
        "width": 720,
        "height": 800,
        "minWidth": 560,
        "minHeight": 480
      }
    ]
  },
  "bundle": {
    "active": false,
    "icon": ["icons/512x512.png", "icons/icon.ico"]
  }
}
